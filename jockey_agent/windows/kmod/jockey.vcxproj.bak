<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <Keyword>KernelModeDriver</Keyword>
    <RootNamespace>jockey</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ConfigurationType>Driver</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <OutDir>x64\Release\</OutDir>
    <IntDir>x64\Release\$(ProjectName)\</IntDir>
    <TargetName>jockey</TargetName>
    <DriverType>WDM</DriverType>
    <GenerateManifest>false</GenerateManifest>
    <LinkIncremental>false</LinkIncremental>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ConfigurationType>Driver</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <OutDir>x64\Debug\</OutDir>
    <IntDir>x64\Debug\$(ProjectName)\</IntDir>
    <TargetName>jockey</TargetName>
    <DriverType>WDM</DriverType>
    <GenerateManifest>false</GenerateManifest>
    <LinkIncremental>false</LinkIncremental>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <PropertyGroup Label="UserMacros" />

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <OmitFramePointers>true</OmitFramePointers>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <CompileAs>CompileAsC</CompileAs>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <DisableSpecificWarnings>28159;28204;28252;28253;28251</DisableSpecificWarnings>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <TreatWarningAsError>false</TreatWarningAsError>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=NTDDI_WIN10_RS5;_AMD64_;DBG=1;_BLDR_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>C:\Program Files (x86)\Windows Kits\10\Include\10.0.28000.0\km;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <GenerateManifest>false</GenerateManifest>
      <OutputFile>$(OutDir)$(TargetName).sys</OutputFile>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
      <RegisterOutput>true</RegisterOutput>
      <SubSystem>NATIVE</SubSystem>
      <TargetMachine>MachineX64</TargetMachine>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
      <IgnoreSpecificDefaultLibraries>libcmt.lib;libcmtd.lib</IgnoreSpecificDefaultLibraries>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>WINVER=0x0A00;_WIN32_WINNT=0x0A00;NTDDI_VERSION=NTDDI_WIN10_RS5;NDIS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Culture>0</Culture>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="jockey_km.c" />
    <ClCompile Include="jockey_hide.c" />
    <ClCompile Include="jockey_driver.c" />
    <ClCompile Include="jockey_etw.c" />
    <ClCompile Include="jockey_obcb.c" />
    <ClCompile Include="jockey_driverhide.c" />
    <ClCompile Include="jockey_cred.c" />
    <ClCompile Include="jockey_kill.c" />
    <ClCompile Include="jockey_mem.c" />
    <ClCompile Include="jockey_net.c" />
    <ClCompile Include="jockey_proc.c" />
    <ClCompile Include="jockey_patch.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="jockey.h" />
  </ItemGroup>

  <PropertyGroup>
    <WDKContentRoot>C:\Program Files (x86)\Windows Kits\10</WDKContentRoot>
  </PropertyGroup>

  <Import Project="$(WDKContentRoot)\build\10.0.28000.0\WindowsDriver.KernelMode.CX.targets" />

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
